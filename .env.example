# ==========================================
# JOBZY ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite default for zero-setup local dev; PostgreSQL supported for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL with pgvector:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobzy?schema=public"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# AI Provider Keys (Optional: when provided, LLM deep evaluation & bullet rewriter run on API; otherwise intelligent local NLP engine is used)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Background Queue (Optional: uses resilient in-memory priority queue if Redis is unavailable)
REDIS_URL=redis://localhost:6379

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
